#!/usr/bin/env bash
# tmux-reload-zsh — Re-source ~/.zshrc in every tmux pane sitting at a zsh prompt
# Usage: tmux-reload-zsh   (bound to prefix + R in tmux.conf)
#
# A pane qualifies only when its own zsh leads the terminal's foreground group,
# so panes running nvim, claude, a zsh script or anything else are left alone,
# as are panes in copy mode. Ctrl+C clears any half-typed line first.

set -euo pipefail

if ! tmux list-sessions &>/dev/null; then
  echo "No tmux server running." >&2
  exit 1
fi

reloaded=0
while read -r pane pid cmd in_mode; do
  [[ $cmd == zsh && $in_mode == 0 ]] || continue
  [[ $(ps -o tpgid= -p "$pid" | tr -d ' ') == "$pid" ]] || continue
  tmux send-keys -t "$pane" C-c 'source ~/.zshrc' Enter
  reloaded=$((reloaded + 1))
done < <(tmux list-panes -a -F '#{pane_id} #{pane_pid} #{pane_current_command} #{pane_in_mode}')

tmux display-message "Reloaded zsh in $reloaded pane(s)"
